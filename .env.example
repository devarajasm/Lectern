# =====================================================================
# Global provider selection (can also be switched at runtime in the UI;
# the UI choice is persisted in the local DB and overrides these defaults)
# =====================================================================
# LLM provider: azure | openai | ollama | openai_compatible | huggingface
LLM_PROVIDER=azure
# Server-side speech (STT + TTS): azure | openai | none
#   "none" = only the in-browser Web Speech engine is offered.
SPEECH_PROVIDER=azure

# ---------------------------------------------------------------- Azure OpenAI
# Uses the Azure OpenAI v1 API (https://<resource>.openai.azure.com/openai/v1/).
# Model values are your *deployment names*.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_LLM_DEPLOYMENT=gpt-5-mini
AZURE_OPENAI_STT_DEPLOYMENT=gpt-4o-mini-transcribe
AZURE_OPENAI_TTS_DEPLOYMENT=gpt-4o-mini-tts
# responses (recommended) | chat (for deployments without Responses API support)
AZURE_OPENAI_API_STYLE=responses
# API version for speech-to-text, which uses the deployment-based endpoint
AZURE_OPENAI_AUDIO_API_VERSION=2025-03-01-preview

# ---------------------------------------------------------------- OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts

# Voice used by server-side TTS (Azure and OpenAI)
TTS_VOICE=marin

# ---------------------------------------------------------------- Local: Ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1:8b

# ---------------------------------------------------------------- Local: any OpenAI-compatible server
# LM Studio (http://localhost:1234/v1), vLLM, llama.cpp server, LocalAI, ...
OPENAI_COMPATIBLE_BASE_URL=http://localhost:1234/v1
OPENAI_COMPATIBLE_API_KEY=not-needed
OPENAI_COMPATIBLE_MODEL=local-model

# ---------------------------------------------------------------- Local: Hugging Face transformers (in-process)
# Requires: pip install -r backend/requirements-local.txt
HF_MODEL=Qwen/Qwen2.5-1.5B-Instruct
HF_DEVICE=auto

# ---------------------------------------------------------------- Storage
DATA_DIR=./data

# ---------------------------------------------------------------- About
# Link to the source code shown in the app (AGPL-3.0: offer the source to network users,
# including any changes you made). Point this at your fork if you modify Lectern.
SOURCE_URL=https://github.com/devarajasm/Lectern

# ---------------------------------------------------------------- Network
# The backend trusts the OS certificate store (macOS Keychain etc.) and ignores
# SSL_CERT_FILE. Add an extra PEM bundle here only if a CA is missing from the OS store.
EXTRA_CA_BUNDLE=
